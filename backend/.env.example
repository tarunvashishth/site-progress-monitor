# Copy to backend/.env for local runs, or set as environment variables in your host.
# Used by BOTH the API and the worker. Contains secrets: never commit real values.

# --- Supabase ---
DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
# Optional least-privilege setup: connect as a dedicated login role (member of authenticated + service_role) and set
DB_SERVICE_ROLE=                          # e.g. service_role: worker/system queries SET ROLE to it (bypasses RLS)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLIC_URL=                      # optional: browser-facing storage URL if it differs from SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=                # SERVER ONLY. Never expose to the browser or commit.
SUPABASE_JWT_SECRET=                      # legacy HS256 projects. Leave empty to verify tokens via JWKS.

# --- API ---
WEB_ORIGIN=http://localhost:3000          # only origin allowed by CORS
MAX_VIDEO_BYTES=2147483648                # 2 GB; must not exceed your Supabase plan/bucket limit
SIGNED_URL_TTL_SEC=3600

# --- Worker: frame extraction ---
POLL_INTERVAL_SEC=5
FRAME_SAMPLE_INTERVAL_SEC=8               # one candidate frame every N seconds (widened for long videos)
MAX_FRAMES=24                             # frames sent to the model
MAX_CANDIDATE_FRAMES=120
FRAME_MAX_SIDE=1280
BLUR_THRESHOLD=60                         # Laplacian variance below this = blurry
DUP_HASH_DISTANCE=4                       # dHash Hamming distance <= this = duplicate
MAX_VIDEO_DURATION_SEC=3600
MAX_PREV_FRAMES=3                         # earlier evidence frames included for comparison

# --- Worker: AI (Qwen3-VL via an OpenAI-compatible endpoint). Leave empty => analysis reports "unavailable". ---
QWEN_VL_BASE_URL=                         # any OpenAI-compatible endpoint (self-hosted vLLM or a hosted/free provider)
QWEN_VL_API_KEY=                          # optional for local servers
QWEN_VL_MODEL=                            # the exact model name your server serves
QWEN_VL_JSON_MODE=true                    # set false if the server rejects response_format
QWEN_VL_TIMEOUT_SEC=180
PROMPT_VERSION=v1
